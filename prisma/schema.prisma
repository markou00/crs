// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum Role {
  admin
  user
}

enum ContainerStatus {
  available
  unavailable
}

enum RepetitionFrequency {
  NONE
  DAILY
  WEEKLY
}

enum AgreementType {
  RESIDUAL_WASTE
  GLASS_WASTE
  GLASS_AND_METAL
  METAL_WASTE
  HOUSEHOLD_WASTE
  COMMERCIAL_WASTE
  HAZARDOUS_WASTE
  CONSTRUCTION_AND_DEMOLITION_WASTE
  RECYCLING
  SPECIAL_WASTE
  ORGANIC_WASTE
  ELECTRONIC_WASTE
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String
  role         Role      @default(user)
  firstName    String?
  lastName     String?
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Tenant {
  id         String      @id @unique
  name       String
  users      User[]
  customers  Customer[]
  agreements Agreement[]
  containers Container[]
  employees  Employee[]
  cars       Car[]
  jobs       Job[]
}

model Customer {
  id           Int         @id @default(autoincrement())
  name         String
  type         String
  contactName  String
  contactEmail String      @unique
  contactPhone String?
  address      String
  city         String
  postalCode   String
  country      String
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  agreements   Agreement[]
}

model Agreement {
  id            Int                 @id @default(autoincrement())
  type          AgreementType       @default(RESIDUAL_WASTE)
  status        String
  containerName String
  customer      Customer            @relation(fields: [customerId], references: [id])
  validFrom     DateTime
  validTo       DateTime?
  comment       String?
  tenantId      String
  Tenant        Tenant              @relation(fields: [tenantId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  customerId    Int
  repetition    RepetitionFrequency @default(NONE)
  jobs          Job[]
}

model Container {
  id          Int             @id @default(autoincrement())
  name        String
  rfid        String
  capacity    Int
  type        String
  status      ContainerStatus @default(available)
  availableAt DateTime        @default(now())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  job         Job?
  jobId       Int?
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  status    String
  email     String   @unique
  phone     String   @unique
  picture   String?
  carId     Int?     @unique
  car       Car?     @relation(fields: [carId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id        Int       @id @default(autoincrement())
  regnr     String    @unique
  model     String
  status    String
  employee  Employee?
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobs      Job[]
}

model Job {
  id          Int                 @id @default(autoincrement())
  status      String
  servicetype String
  type        String
  repetition  RepetitionFrequency @default(NONE)
  date        DateTime
  agreement   Agreement           @relation(fields: [agreementId], references: [id])
  comment     String?
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  containerId Int?                @unique
  agreementId Int
  carId       Int?
  container   Container?          @relation(fields: [containerId], references: [id])
  car         Car?                @relation(fields: [carId], references: [id])
}
